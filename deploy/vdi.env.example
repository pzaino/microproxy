# Data-plane environment for one MicroProxy-per-VDI deployment.
#
# Copy to ./vdi.env (or a per-VDI secret file) and keep it out of version
# control. docker-compose.yml loads this file for the microproxy service.
#
# The session API token protects credential rotation for this VDI only. Give
# every VDI its own value; never reuse control-plane API keys here.
MICROPROXY_SESSION_API_KEY=replace-with-strong-random-session-api-key

# Upstream proxy endpoint and base credentials. The endpoint must be a complete
# URL without embedded credentials. Adjust the session mode/templates in the
# mounted config for the provider's actual sticky-session syntax.
MICROPROXY_UPSTREAM_ENDPOINT=http://upstream-proxy.example:3128
MICROPROXY_UPSTREAM_USER=replace-with-upstream-username
MICROPROXY_UPSTREAM_PASSWORD=replace-with-upstream-password
